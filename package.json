{
	"name": "awesome-sirus-launcher",
	"version": "1.0.31",
	"description": "Electron/Vue launcher for Sirus WoW addons, patches, backups, accounts and game launch.",
	"author": "fxpw accidev",
	"license": "MIT",
	"type": "module",
	"main": "out/main/index.js",
	"packageManager": "npm@11.19.1",
	"engines": {
		"node": ">=24.22.3",
		"npm": ">=11.19.1"
	},
	"scripts": {
		"dev": "electron-vite dev",
		"start": "electron-vite dev",
		"build": "npm run typecheck && electron-vite build",
		"package": "npm run build && electron-builder --publish never",
		"package:dir": "npm run build && electron-builder --dir --publish never",
		"package:win": "npm run build && electron-builder --win --publish never",
		"preview": "electron-vite preview",
		"typecheck": "npm run typecheck:web && npm run typecheck:node",
		"typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
		"typecheck:node": "tsc --noEmit -p tsconfig.node.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"lint:format": "prettier --check .",
		"check": "npm run typecheck && npm test",
		"postinstall": "install-electron --no"
	},
	"dependencies": {
		"node-machine-id": "^1.1.12",
		"yauzl": "^3.4.0",
		"yazl": "^3.3.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@lucide/vue": "^1.77.0",
		"@types/node": "^24.19.2",
		"@types/yauzl": "^3.4.0",
		"@types/yazl": "^3.3.1",
		"@vitejs/plugin-vue": "^6.0.11",
		"electron": "^45.4.1",
		"electron-builder": "^26.18.0",
		"electron-vite": "^6.0.0",
		"prettier": "^3.10.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"vue": "^3.5.46",
		"vue-tsc": "^3.3.14"
	},
	"build": {
		"appId": "dev.fxpw.awesome-sirus-launcher",
		"productName": "Awesome Sirus Launcher",
		"directories": {
			"output": "release"
		},
		"icon": "build/icon.ico",
		"files": [
			"out/**/*",
			"package.json"
		],
		"win": {
			"target": [
				"nsis",
				"portable"
			]
		},
		"nsis": {
			"artifactName": "Awesome-Sirus-Launcher-Setup-${version}.${ext}",
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true,
			"runAfterFinish": true
		},
		"portable": {
			"artifactName": "Awesome-Sirus-Launcher-Portable-${version}.${ext}"
		}
	},
	"overrides": {
		"minimatch@>=7.0.0 <11.0.1": "^11.0.1"
	},
	"allowScripts": {
		"electron-winstaller@5.4.0": true
	}
}
